<Window x:Class="Baba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baba"
        Width="320"
        Height="390"
        MinWidth="160"
        MinHeight="200"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Closing="OnClosing">
    <Grid MouseLeftButtonDown="DragWindow"
          MouseRightButtonUp="ShowContextMenu">
        <Border x:Name="SpeechBubble"
                Margin="16,8,16,0"
                Padding="14,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#FFFDF7"
                BorderBrush="#54504B"
                BorderThickness="2"
                CornerRadius="14"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechText"
                       Foreground="#252321"
                       FontSize="16"
                       TextWrapping="Wrap" />
        </Border>
        <Grid x:Name="MascotArea"
              Margin="28,104,28,20">
            <Image x:Name="MascotImage"
                   Stretch="Uniform"
                   Visibility="Collapsed" />
            <Border x:Name="PlaceholderMascot"
                    Background="#FF5852A6"
                    BorderBrush="#FFFDF7"
                    BorderThickness="5"
                    CornerRadius="120">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="64"
                               Text="● ●" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               Text="mascot" />
                </StackPanel>
            </Border>
            <Border x:Name="ResizeFrame"
                    Margin="4"
                    BorderBrush="#FFFDF7"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            <Grid x:Name="ResizeHandles"
                  Visibility="Collapsed">
                <Thumb Tag="Top"
                       Margin="14,0,14,0"
                       VerticalAlignment="Top"
                       Height="12"
                       Cursor="SizeNS"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="Bottom"
                       Margin="14,0,14,0"
                       VerticalAlignment="Bottom"
                       Height="12"
                       Cursor="SizeNS"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="Left"
                       Margin="0,14,0,14"
                       HorizontalAlignment="Left"
                       Width="12"
                       Cursor="SizeWE"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="Right"
                       Margin="0,14,0,14"
                       HorizontalAlignment="Right"
                       Width="12"
                       Cursor="SizeWE"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="TopLeft"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Width="18"
                       Height="18"
                       Cursor="SizeNWSE"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="TopRight"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Width="18"
                       Height="18"
                       Cursor="SizeNESW"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="BottomLeft"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Width="18"
                       Height="18"
                       Cursor="SizeNESW"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
                <Thumb Tag="BottomRight"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Width="18"
                       Height="18"
                       Cursor="SizeNWSE"
                       DragStarted="ResizeHandleDragStarted"
                       DragCompleted="ResizeHandleDragCompleted"
                       Opacity="0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
