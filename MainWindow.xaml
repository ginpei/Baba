<Window x:Class="Baba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baba"
        Width="320"
        Height="390"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Closing="OnClosing">
    <Grid MouseLeftButtonDown="DragWindow">
        <Border x:Name="SpeechBubble"
                Margin="16,8,16,0"
                Padding="14,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#FFFDF7"
                BorderBrush="#54504B"
                BorderThickness="2"
                CornerRadius="14"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechText"
                       Foreground="#252321"
                       FontSize="16"
                       TextWrapping="Wrap" />
        </Border>
        <Grid Margin="28,104,28,20">
            <Image x:Name="MascotImage"
                   Stretch="Uniform"
                   Visibility="Collapsed" />
            <Border x:Name="PlaceholderMascot"
                    Background="#FF5852A6"
                    BorderBrush="#FFFDF7"
                    BorderThickness="5"
                    CornerRadius="120">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="64"
                               Text="● ●" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               Text="mascot" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
